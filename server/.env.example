# ---------------------------------------------------------------------------
# HarborPoint Claims API — environment template (placeholders only)
# Copy to server/.env and fill in. Never commit real values.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
# Comma-separated list of allowed browser origins
CLIENT_ORIGIN=http://localhost:5173

# DATA_MODE:
#   supabase -> Supabase Postgres + Supabase Auth + Supabase Storage (production mode)
#   mock     -> MOCK MODE (local demo): embedded PGlite database, demo authentication,
#               local file storage. Refuses to start when NODE_ENV=production.
DATA_MODE=mock

# --- Supabase (required when DATA_MODE=supabase) ---------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
# Server-side only. Never expose this key to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Postgres connection string (Project Settings -> Database -> Connection string, session pooler)
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-region.pooler.supabase.com:5432/postgres
SUPABASE_DB_SSL=true
SUPABASE_STORAGE_BUCKET=claim-documents

# --- Local demo mode (DATA_MODE=mock) -------------------------------------
# Directory for the embedded database and uploaded files (gitignored).
MOCK_DATA_DIR=./.data
# Set to "memory" to keep the demo database in memory only (reset on restart).
MOCK_DB_PERSISTENCE=file
# Secret used to sign demo-mode session tokens. Generate any random string.
MOCK_AUTH_SECRET=change-me-to-a-long-random-string
# Password given to every seeded demo account in mock mode.
MOCK_DEMO_PASSWORD=HarborDemo!2026

# --- Integrations -------------------------------------------------------------
# Email adapter: console (logs only, reported as LOGGED_DEV — never as SENT) | disabled
EMAIL_ADAPTER=console
EMAIL_FROM=claims@harborpoint.example
# Payment adapter: only "simulated" is implemented in the MVP. It never moves money.
PAYMENT_ADAPTER=simulated

# Login/registration attempts allowed per IP per 15 minutes (default 30 in production, 300 otherwise)
# AUTH_RATE_LIMIT=30

# --- Jobs -----------------------------------------------------------------------
# Interval for the overdue-task sweep in minutes (0 disables the timer)
OVERDUE_SWEEP_MINUTES=15

# --- Development provisioning (npm run provision:dev, supabase mode only) ----
# Password assigned to the demo accounts created in your Supabase project.
DEV_SEED_PASSWORD=
