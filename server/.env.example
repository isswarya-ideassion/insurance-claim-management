# ---------------------------------------------------------------------------
# HarborPoint Claims API — environment template (placeholders only)
# Copy to server/.env and fill in. Never commit real values.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
# Comma-separated list of allowed browser origins
CLIENT_ORIGIN=http://localhost:5173

# --- PostgreSQL (required) ---------------------------------------------------
# Any PostgreSQL 14+ server. The user needs to create tables, functions and the
# anon/authenticated roles on first migration (CREATEROLE).
DATABASE_URL=postgresql://harborpoint:your-db-password@localhost:5432/harborpoint
# disable | require (encrypted, certificate not checked) | verify-full
DATABASE_SSL=disable
DATABASE_POOL_MAX=10
# Apply pending migrations from database/migrations when the API starts.
DB_MIGRATE_ON_START=true

# --- Sign-in (required) --------------------------------------------------------
# Signs session tokens. At least 32 random characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
AUTH_TOKEN_SECRET=change-me-to-a-long-random-string
AUTH_TOKEN_TTL_HOURS=8

# --- Field-level encryption ---------------------------------------------------
# AES-256-GCM key for bank details and claimant contact data: 32 random bytes,
# base64 (or 64 hex characters). Required unless SEED_DEMO_DATA=true. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Store it in a secrets manager. Losing it makes encrypted fields unreadable.
# When moving from Supabase, use the exact key the Supabase deployment used.
FIELD_ENCRYPTION_KEY=

# --- Demo data (development only) ----------------------------------------------
# true = create fictional demo users, policies and claims on start (refused in production).
SEED_DEMO_DATA=false
# Password given to every demo account.
DEMO_PASSWORD=HarborDemo!2026

# --- Integrations -------------------------------------------------------------
# Email adapter: console (logs only, reported as LOGGED_DEV — never as SENT) | disabled
EMAIL_ADAPTER=console
EMAIL_FROM=claims@harborpoint.example
# Payment adapter: only "simulated" is implemented in the MVP. It never moves money.
PAYMENT_ADAPTER=simulated

# Login/registration attempts allowed per IP per 15 minutes (default 30 in production, 300 otherwise)
# AUTH_RATE_LIMIT=30

# --- AI automation (server-side only; never put AI keys in client/.env) --------
# none = AI features disabled; the API returns setup instructions, never mock results.
# anthropic = Claude API (needs ANTHROPIC_API_KEY). ollama = local models served by Ollama.
AI_PROVIDER=none
# Required when AI_PROVIDER=anthropic. Keep it in this file or a secrets manager.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# Per-request timeout (ms) and automatic retries for transient provider errors.
AI_TIMEOUT_MS=90000
AI_MAX_RETRIES=2
# Used when AI_PROVIDER=ollama. Install Ollama, then: ollama pull llama3.1:8b (and llama3.2-vision for image extraction).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_VISION_MODEL=llama3.2-vision
# Bearer key for a hosted Ollama (ollama.com) or one behind an authenticating proxy; leave empty for a local Ollama.
OLLAMA_API_KEY=

# --- Hosting without a long-running process (Vercel) -------------------------
# Secret for GET /api/v1/internal/cron/jobs (Authorization: Bearer <CRON_SECRET>). Unset disables the endpoint.
# CRON_SECRET=
# Largest upload in MB (1-10). Use 4 on Vercel, which caps requests at 4.5 MB.
# MAX_UPLOAD_MB=10

# --- Jobs -----------------------------------------------------------------------
# Interval in minutes for the overdue-task, SLA-escalation and claim-deadline reminder sweeps (0 disables the timer)
OVERDUE_SWEEP_MINUTES=15
# Claims due within this many hours get an "approaching deadline" reminder
REMINDER_LEAD_HOURS=24

# --- Records --------------------------------------------------------------------
# Customer records are kept this many years after the last activity
CUSTOMER_RECORD_RETENTION_YEARS=7

# --- One-time import from Supabase (npm run db:import-supabase) ------------------
# Only needed while moving an existing Supabase project; see docs/SETUP.md.
# SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-region.pooler.supabase.com:5432/postgres
# SUPABASE_DB_SSL=require
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SUPABASE_STORAGE_BUCKET=claim-documents
