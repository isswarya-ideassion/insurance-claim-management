{
  "name": "insurance-claim-management",
  "version": "1.0.0",
  "private": true,
  "description": "HarborPoint General Insurance — Claims Operations Hub",
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,client -c cyan,magenta \"npm run dev -w server\" \"npm run dev -w client\"",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "test": "npm run test -w server && npm run test -w client",
    "test:server": "npm run test -w server",
    "test:client": "npm run test -w client",
    "lint": "npm run lint -w server && npm run lint -w client",
    "db:transitions-sql": "node server/scripts/generate-transition-sql.js",
    "db:migrate": "npm run db:migrate -w server",
    "db:status": "npm run db:status -w server",
    "db:seed-demo": "npm run db:seed-demo -w server",
    "db:import-supabase": "npm run db:import-supabase -w server --"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isswarya-ideassion/insurance-claim-management.git"
  },
  "license": "ISC",
  "overrides": {
    "shell-quote": "^1.11.0"
  }
}
