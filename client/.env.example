# ---------------------------------------------------------------------------
# HarborPoint Claims Hub — frontend environment template (placeholders only)
# Copy to client/.env and fill in. Only VITE_* variables reach the browser,
# so never put a service-role key or any other secret here.
# ---------------------------------------------------------------------------

# mock     -> MOCK MODE: logs in against the API's demo accounts (server DATA_MODE=mock)
# supabase -> Supabase Auth in the browser (server DATA_MODE=supabase)
VITE_APP_MODE=mock

# API base URL. The default "/api/v1" uses the Vite dev proxy to http://localhost:4000.
VITE_API_URL=/api/v1

# Required when VITE_APP_MODE=supabase. The anon key is public by design and is
# protected by row-level security; it is NOT the service-role key.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
